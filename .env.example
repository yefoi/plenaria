# Clave de TypeSafe AI (jev). Solo se usa en scripts de clasificación (servidor).
# Consíguela en https://console.typesafe.ai/keys
TYPESAFE_AI_API_KEY=

# Opcional: clave de workspace de classifier.dev para mayores límites.
# Sin clave funciona el acceso anónimo (límites compartidos por IP).
CLASSIFIER_API_KEY=

# Opcional: User-Agent identificable para las descargas (con contacto).
PLENARIA_USER_AGENT=
